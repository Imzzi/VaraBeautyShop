{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node --import tsx scripts/generate-sitemap.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-server/server.cjs && esbuild serverFxSync.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-server/fx-sync.cjs",
    "start": "node dist-server/server.cjs",
    "preview": "vite preview",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:fx": "node --import tsx --test tests/fx-rates.test.mts",
    "test:security": "node --import tsx --test tests/checkout-security.test.mts",
    "test:db": "node --experimental-test-module-mocks --import tsx --test tests/catalog-db.test.mts"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/blob": "^2.8.0",
    "@vercel/schedules": "^0.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "10.9.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "resend": "^6.28.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
