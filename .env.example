# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Kavenegar SMS Gateway API Key (from https://panel.kavenegar.com)
KAVENEGAR_API_KEY=

# Kavenegar Lookup / Verify SMS Template Name (created in Kavenegar panel > اعتبارسنجی)
KAVENEGAR_TEMPLATE=temp1

# Turso Serverless SQLite Database (provided automatically by Vercel Integration)
# In production on Vercel, set these to use remote serverless SQLite storage:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin Panel Custom URL Route (Hidden from crawlers and public search engines)
# Change this to any custom slug (e.g., /vara-secure-9x7k or /manage-vara-shop)
# Default fallback: /vara-admin-panel (Standard /admin and /cms are hidden & return 404/home)
VITE_ADMIN_PATH=/vara-admin-panel

# Admin Panel Credentials (configured in Vercel Environment Variables)
# You can set either ADMIN_USERNAME / ADMIN_PASSWORD or ADMIN_USER / ADMIN_PASS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Tech Admin & Cloud Integrations Tab Access Password
# Protects the system diagnostics, Turso database console, Vercel Blob explorer, and API monitors
TECH_ADMIN_PASSWORD=

# Resend Transactional Email Service
# Create a free account at https://resend.com (3,000 free emails/month)
# Get your API key from: https://resend.com/api-keys (named "vara")
RESEND_API_KEY=
# Sender name and email. Default sender display name is "Vara Beauty Shop":
RESEND_SENDER_NAME="Vara Beauty Shop"
RESEND_SENDER_EMAIL=mail@varabeauty.ir

# Vercel Blob Storage Token (Auto-generated by Vercel when connecting Blob store)
# Go to Vercel Dashboard -> Storage -> Create Database -> Blob -> Connect to Project
VARA_MEDIA_STORE_ID=

# Zarinpal Payment Gateway v4 (from https://next.zarinpal.com)
# Set your 36-character merchant ID, or leave blank / "sandbox" for test gateway mode
ZARINPAL_MERCHANT_ID=
# Set to true for test transactions, false for production
ZARINPAL_SANDBOX=false
# Optional: Static IPv4 VPS Payment Hub URL (e.g., https://pay.varabeauty.ir/zarinpal) for Vercel deployments
ZARINPAL_PROXY_URL=
# Optional: Per-website secret token configured in your VPS Nginx payment hub
ZARINPAL_PROXY_SECRET=

# NextPay Payment Gateway (from https://nextpay.org -> ایجاد درگاه)
# Works natively on Vercel Serverless without requiring a static IPv4
NEXTPAY_API_KEY=

# Dedicated random customer-session key of at least 32 bytes. Required on Vercel/production.
CUSTOMER_SESSION_SECRET=

# Exact HTTPS origin for payment browser returns.
PAYMENT_CALLBACK_ORIGIN=
